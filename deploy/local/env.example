# Copy to an untracked .env file only on the approved server.
# This example binds the application to the notebook itself. Tablet access needs an
# approved HTTPS reverse proxy and a hostname trusted by the tablets.
DB_PASSWORD=replace-with-a-strong-unique-secret
APP_NODE_ID=office-notebook-01
APP_PUBLIC_BASE_URL=http://127.0.0.1:8080
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
LOCAL_HTTP_PORT=8080
SESSION_COOKIE_SECURE=false

