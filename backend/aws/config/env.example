# 컨테이너 환경변수 또는 Secrets Manager로 주입할 항목입니다.
SPRING_PROFILES_ACTIVE=aws
DB_URL=jdbc:postgresql://YOUR-RDS-ENDPOINT:5432/boundary?sslmode=verify-full&sslrootcert=/app/certs/rds-ca.pem
DB_USER=boundary_app
DB_PASSWORD=replace-with-rds-password
APP_NODE_ID=aws-seoul-01
APP_PUBLIC_BASE_URL=https://YOUR-SERVICE-HOSTNAME
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
# RDS CA 파일은 이미지 또는 읽기 전용 마운트로 위 경로에 별도 제공해야 합니다.
