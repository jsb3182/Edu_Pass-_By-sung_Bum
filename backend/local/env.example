# backend/local/.env로 복사합니다. Docker Compose용 예시입니다.
DB_PASSWORD=replace-with-a-strong-unique-secret
APP_NODE_ID=office-notebook-01
APP_PUBLIC_BASE_URL=http://127.0.0.1:8080
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
LOCAL_HTTP_PORT=8080
LOCAL_BIND_ADDRESS=127.0.0.1
SESSION_COOKIE_SECURE=false
APP_ALLOW_INSECURE_HTTP=false

# 같은 Wi-Fi 태블릿에서 HTTP 개발 테스트를 할 때 위 설정을 변경합니다.
# LOCAL_BIND_ADDRESS=0.0.0.0
# APP_PUBLIC_BASE_URL=http://192.168.0.10:8080
# APP_ALLOW_INSECURE_HTTP=true
# IP는 ipconfig로 확인한 실제 PC IPv4 주소로 바꿉니다.
